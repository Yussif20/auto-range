# Local: the Docker container server-postgres-1 (port 3500)
DATABASE_URL="postgresql://postgres:postgres@localhost:3500/auto_range"

# Seed: first admin account (change before seeding prod)
SEED_ADMIN_EMAIL="admin@autorange.example"
SEED_ADMIN_PASSWORD="change-me"

# Signs the admin session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"
