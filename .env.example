# Local: the Docker container server-postgres-1 (port 3500)
DATABASE_URL="postgresql://postgres:postgres@localhost:3500/auto_range"
# Direct connection for migrations (on Neon: the non-pooled URL; locally the same as above)
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:3500/auto_range"

# Seed: first admin account (change before seeding prod)
SEED_ADMIN_EMAIL="admin@autorange.example"
SEED_ADMIN_PASSWORD="change-me"

# Signs the admin session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# Public URL, used for canonical links, sitemap and share images
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Seed: set to 0 to skip sample bookings, part requests and messages (production)
SEED_SAMPLE_DATA="1"

# Admin photo uploads (Vercel Blob). Set by Vercel when the store is connected; for local runs put only this in .env.local
BLOB_READ_WRITE_TOKEN=
